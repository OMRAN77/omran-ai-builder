{
  "manifest_version": 3,
  "name": "TARYAM — فاحص الكازينو المباشر",
  "version": "1.0.0",
  "description": "يقرأ جلستك داخل الكازينو مباشرة: جولات الروليت، الرصيد قبل/بعد، ومن أين تُحمَّل اللعبة — لعرض اللجنة. يقرأ فقط، لا يعدّل شيئًا.",
  "content_scripts": [
    {
      "matches": [
        "*://*.dubibet999.com/*",
        "*://*.dubibet.com/*",
        "*://*.dubibet888.com/*"
      ],
      "js": ["core.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inpage.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
