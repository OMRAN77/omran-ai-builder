# Change specs — internal notes, not part of the product.
specs/

# Never publish a source archive from the web root: it hands an attacker the
# full server logic, and the old copy still contained the hardcoded
# 'fallback-dev-secret-change-me' default.
source-code.zip
*.zip

# Scratch output from the in-browser ffmpeg pipeline.
videos_tmp/

# v-root-tidy: ملفّات قديمة نُقلت من الجذر (لقطات تشخيص، أرشيف مصدر، مقاطع ffmpeg مؤقّتة) —
# محفوظة في المستودع ولا تُنشر.
archive/

# Marketing renders and demo clips. Nothing in the app links to these paths —
# the two demo videos the UI actually plays are served from Vercel Blob
# storage (6tfgxvttzyoiavtu.public.blob.vercel-storage.com), not from here.
# 44 MB of CDN weight for files no visitor ever requests.
# NOTE: assets/characters/ IS used by the app and is deliberately NOT ignored.
video/
assets/*.mp4

# ميزة متقاعدة (v403) — حارس _retired.js يرفض مسارها، وملفها لا يُنشر.
api/_lib/car-tools.js
js/app-16-snapbuild.js
js/_floorplan-editor-client.js

# أدوات البناء تعيش في المستودع لا على الـCDN.
scripts/

# نسخ محفوظة قبل التعديل. index.html.orig كان يُخدَم حيًّا بـ200: ٤٥٥ ك.ب من
# قشرة ما قبل v415 (بلا سلّم نصّي، ٦٠ سطرًا متأخّرة). زائر يفتح الرابط يرى
# تطبيقًا قديمًا، ومحرّك بحث قد يفهرسه نسخةً موازية.
*.orig
*.bak

# فحوص ما قبل الدمج. تعيش في المستودع لا على الـCDN.
tests/
.github/

# The knowledge/ folder is the agent's own working notes (state, pitfalls, plans,
# owner name). Useful in the repo, but it was being served publicly at
# /knowledge/*.md - anyone could read the project's state and its list of
# unfixed weaknesses. Keep it in git, never ship it to the CDN.
knowledge/

# v-cc-bridge: جسر Claude Code يعمل على خادم المالك لا على Vercel.
cc-bridge/

# v-call-agent: خدمة الاتّصال (Twilio ↔ الصوت) تعمل على Railway لا على Vercel، ومصدرها لا يُنشر على الـCDN.
call-relay/

# v-cc-playbook: مهارات المشروع لـClaude Code تعيش في المستودع لا على الـCDN.
.claude/

# v-store-twa: ملفّات متجر هواوي (لقطات المتجر وملاحظات المراجعة وخطوات البناء) للمالك لا للـCDN.
store/

# v-inspire: مصادر تجارب «الإلهام» (النواة والقوالب) — المنشور هو inspire/city/*.html المبنيّ منها.
inspire/src/
