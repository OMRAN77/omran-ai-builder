# Optional: only needed when a separate frontend calls this project's API.
# The Vercel deployment itself is allowed automatically as the same origin.
ALLOWED_ORIGINS=https://omran-ai-builder.vercel.app

# صور المحادثة (v-nano-pro-edit) — الافتراضيات هي المقصودة؛ لا تضبط هذه إلا لسبب:
# IMAGE_CREATIVE_MODEL=gemini-3-pro-image   # نانو بنانا برو للترقية/الفكرة المختلفة/الأسلوب/ترقية المشهد/«نانو:»
# IMAGE_EDIT_MODEL=gemini-2.5-flash-image   # نانو 2.5 للتعديل الموضعي (غيّر اللون/شيل الخلفية)
# IMAGE_BEST_OF=2                           # عدد المرشّحين بالتوازي في المسارات الإبداعية (ترقية/فكرة/أسلوب): 1 يوقفه، 2 = ضعف تكلفة الصورة، الحد 3
# IMAGE_DUO=off                             # on = محرّكان + حكم لكل تعديل موضعي (تكلفة ×3)
# IMAGE_REQUEST_CHECK=on                    # off = يعطّل فحص «هل نُفِّذ الطلب؟» بعد كل تعديل وإعادة المحاولة مرة عند الفشل
# IMAGE_INTENT_LLM=on                       # off = يعطّل مصنّف النيّة بالنموذج (flash) الذي يوسّع التعابير النمطية للطلبات القصيرة على صورة
# IMAGE_RAW_CREATIVE=off                    # on = الترقية/الفكرة الجديدة/تحويل الأسلوب ترسل كلمات المستخدم وحدها مع سطر جودة — كتطبيق Gemini حرفيًا (للمقارنة)
# IMAGE_RAW_DEFAULT=off                     # on = يرسل نصّ التوليد الجديد خامًا كتطبيق Gemini (الافتراضي: أوامر مهندسة؛ «نانو:» يبقى خامًا صراحةً)
